{
  "name": "@shelter.money/mcp",
  "version": "1.0.7",
  "mcpName": "io.github.nextauralabs/shelter",
  "description": "Connect AI agents to scoped financial context from your own Shelter account",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "shelter-mcp": "dist/bin/shelter-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "smithery.yaml",
    "server.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin/shelter-mcp.ts src/bin/shelter-mcp-http.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/bin/shelter-mcp.ts src/bin/shelter-mcp-http.ts --format esm --watch",
    "start": "node dist/bin/shelter-mcp-http.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "shelter",
    "finance",
    "financial-coaching",
    "budgeting",
    "cash-flow",
    "personal-finance",
    "ai",
    "claude",
    "cursor",
    "codex",
    "openai",
    "anthropic",
    "plaid",
    "banking"
  ],
  "author": "Shelter",
  "license": "MIT",
  "homepage": "https://shelter.money/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextauralabs/shelter-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/nextauralabs/shelter-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@smithery/cli": "^4.1.4",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
