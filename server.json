{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nextauralabs/shelter",
  "title": "Shelter",
  "description": "Connect AI agents to scoped financial context from your own Shelter account",
  "websiteUrl": "https://shelter.money/developers",
  "repository": {
    "url": "https://github.com/nextauralabs/shelter-mcp",
    "source": "github"
  },
  "version": "1.0.6",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@shelter.money/mcp",
      "version": "1.0.6",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SHELTER_API_KEY",
          "description": "Your scoped Shelter API key. Financial values are suppressed without one.",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "SHELTER_API_URL",
          "description": "Custom API base URL (default: https://api.shelter.money/agent)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
